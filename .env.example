# Environment Configuration

# Database (Supabase PostgreSQL in production; PGlite used in-memory for testing)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
USE_REAL_POSTGRES=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Feature Flags / Safe-by-default Modes
DRY_RUN_MODE=true
ENABLE_PRODUCTION_SENDS=false

# LLM Providers (mock, mistral, openai)
LLM_PROVIDER=mock
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
OPENAI_API_KEY=

# Email Providers (Mock used by default in Phase 0; Resend for Phase 4+)
EMAIL_PROVIDER=mock
RESEND_API_KEY=

# Telegram Integration (Phase 5+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
